{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Usage Widget",
  "version": "0.1.0",
  "identifier": "io.github.marawaneldeib.claude-usage-widget",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "MarawanEldeib",
    "homepage": "https://github.com/MarawanEldeib/claude-usage-widget",
    "shortDescription": "Floating, token-free Claude usage widget",
    "longDescription": "Shows your Claude 5-hour and weekly usage, reset countdowns, model and context % in a small always-on-top widget. Reads only local files; never your Claude login.",
    "category": "Utility",
    "externalBin": ["binaries/cuw-capture"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
