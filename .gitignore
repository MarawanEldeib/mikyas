# build output
/target/
/dist/
/node_modules/
/src-tauri/gen/
/src-tauri/binaries/*
!/src-tauri/binaries/.gitkeep

# local secrets and machine data — never commit
.env
.env.*
*.pem
*.pfx
.credentials.json
**/capture/*.json
history.jsonl

# widget data files, in case MIKYAS_DATA_DIR points inside the repo. For development use
# MIKYAS_DATA_DIR=<repo>\.mikyas-data (ignored as a whole).
/.mikyas-data/
/bin/
**/backups/
**/settings-*.json
wrap.json
state.json
alerts.json
positions.json
watchdog.json
update-check.json

# editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.log

# local assistant tooling (never published)
/.claude/
CLAUDE.local.md
