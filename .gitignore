# build output
/target/
/dist/
/node_modules/
/src-tauri/gen/
/src-tauri/binaries/*
!/src-tauri/binaries/.gitkeep

# local secrets and machine data — never commit
.env
.env.*
*.pem
*.pfx
.credentials.json
**/capture/*.json
history.jsonl

# editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.log
